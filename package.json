{
  "name": "pg-advisory-lock",
  "type": "module",
  "version": "3.0.0",
  "packageManager": "bun@1.4.4",
  "description": "TypeScript library for PostgreSQL advisory locks",
  "author": "Ilya Semenov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/pg-advisory-lock.git"
  },
  "homepage": "https://github.com/IlyaSemenov/pg-advisory-lock#readme",
  "bugs": "https://github.com/IlyaSemenov/pg-advisory-lock/issues",
  "imports": {
    "#test-utils": "./test-utils/index.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "testing": [
        "./dist/testing.d.cts"
      ]
    }
  },
  "files": [
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "lefthook install",
    "types": "bun check && bun check -p tests",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "lint": "biome check --write ."
  },
  "peerDependencies": {
    "postgres": "^3.4.0 || ^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.4.4",
    "postgres": "^4.0.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2"
  }
}
