{
  "name": "pg-advisory-lock",
  "version": "4.0.0",
  "description": "Coordinate exclusive work across application instances with PostgreSQL session-level advisory locks.",
  "homepage": "https://github.com/IlyaSemenov/pg-advisory-lock#readme",
  "bugs": "https://github.com/IlyaSemenov/pg-advisory-lock/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/pg-advisory-lock.git"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "imports": {
    "#test-utils": "./test-utils/index.ts"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./testing": "./dist/testing.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "lefthook install",
    "types": "bun check && bun check -p tests",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "release": "changesets-local",
    "release:check": "bun run build && bun run types && bun run test"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@ilyasemenov/oxc-config": "^0.1.2",
    "@tsconfig/bun": "^1.0.11",
    "@types/bun": "^1.4.4",
    "changesets-local": "^1.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "postgres": "^4.0.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "postgres": "^3.4.0 || ^4.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.4.4"
}
